{
  "name": "hubkon-pay-backend",
  "version": "1.0.0",
  "description": "Backend industrial para Hubkon Pay",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --coverage",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "keywords": [
    "backend",
    "express",
    "auth",
    "rbac",
    "blockchain",
    "fintech"
  ],
  "author": "Filipe Alexandre",
  "license": "MIT",
  "dependencies": {
    "@pythnetwork/pyth-solana-receiver": "^0.13.0",
    "@sendgrid/mail": "^8.1.6",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.4",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.3.1",
    "elliptic": "^6.6.1",
    "express": "^4.22.1",
    "express-list-endpoints": "^7.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-winston": "^4.2.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.4",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.12",
    "prompt-sync": "^4.2.0",
    "readline-sync": "^1.4.10",
    "redis": "^5.11.0",
    "resend": "^6.9.1",
    "rpc-websockets": "7.11.0",
    "stripe": "^20.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover"
    ]
  }
}
